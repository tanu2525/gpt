MONGODB_URI=mongodb://127.0.0.1:27017/authkey_zoho
# Use a random secret of 32+ characters. Do not commit the real value.
AUTHKEY_ENCRYPTION_SECRET=replace-with-a-random-32-character-minimum-secret
# Configure this after Authkey gives you the callback signing secret.
AUTHKEY_WEBHOOK_SECRET=
# Override only if Authkey provides different production endpoints.
AUTHKEY_TEMPLATE_URL=
AUTHKEY_WHATSAPP_URL=
AUTHKEY_SMS_URL=https://api.authkey.io/request
DEFAULT_COUNTRY_CODE=91
